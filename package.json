{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "sail:dev": "./vendor/bin/sail npm run dev",
        "sail:build": "./vendor/bin/sail npm run build",
        "sail:start": "./vendor/bin/sail up -d",
        "sail:stop": "./vendor/bin/sail down",
        "sail:restart": "./vendor/bin/sail restart",
        "sail:bash": "./vendor/bin/sail bash",
        "db:migrate": "./vendor/bin/sail artisan migrate",
        "db:migrate:status": "./vendor/bin/sail artisan migrate:status",
        "db:migrate:rollback": "./vendor/bin/sail artisan migrate:rollback"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "autoprefixer": "^10.6.2",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "postcss": "^8.5.32",
        "tailwindcss": "^4.3.5",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@vitejs/plugin-vue": "^6.0.10",
        "axios": "^1.21.1",
        "pinia": "^4.1.0",
        "viem": "^2.57.17",
        "vue": "^3.5.45"
    }
}
